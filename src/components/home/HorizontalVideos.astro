---
import ScrollReveal from "@/components/shared/ScrollReveal.tsx";
import SectionHeader from "@/components/shared/SectionHeader.astro";
import VideoGrid, { type VideoItem } from "@/components/shared/VideoGrid.astro";

// Versiones web generadas con `scripts/optimize-videos.sh` (sin audio, 30 fps, ≤20 s).
import h1 from "@/assets/videos/web/horizontal/h1.mp4?url";
import h2 from "@/assets/videos/web/horizontal/h2.mp4?url";
import h3 from "@/assets/videos/web/horizontal/h3.mp4?url";
import h1Poster from "@/assets/videos/web/horizontal/h1.jpg";
import h2Poster from "@/assets/videos/web/horizontal/h2.jpg";
import h3Poster from "@/assets/videos/web/horizontal/h3.jpg";

const videos: VideoItem[] = [
  { src: h1, poster: h1Poster, label: "Proceso de maquinado CNC" },
  { src: h2, poster: h2Poster, label: "Centro de maquinado en acción" },
  { src: h3, poster: h3Poster, label: "Detalle de proceso" },
];
---

<section class="section-py bg-canvas">
  <div class="container-custom">
    <ScrollReveal client:visible direction="up" className="mb-12">
      <SectionHeader
        eyebrow="Nuestros Procesos"
        title="Precisión en Movimiento"
        subtitle="Conozca nuestro equipo de alta tecnología trabajando en tiempo real para ofrecer resultados impecables."
      />
    </ScrollReveal>

    <VideoGrid videos={videos} columns={3} aspectRatio="horizontal" />
  </div>
</section>
